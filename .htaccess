# Field Ledger reminder: keep production serving quiet, explicit, and dependable.
# Deployed to Hostinger's public_html/ as part of dist/public/.

# --- SPA fallback -----------------------------------------------------------
# Direct hits to /solutions/... and /insights/... must reach the React app.
# Real files and the pre-rendered SEO directories are served as-is; everything
# else falls back to index.html so wouter can route it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical host. www and the bare domain both answered 200, which is
  # duplicate content: search engines see two copies of every page.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # URLs people and crawlers commonly guess, sent to the section that actually
  # holds that content. These point at real content rather than the bare
  # homepage: redirecting a missing page to "/" is treated as a soft 404, which
  # is the thing the ErrorDocument below exists to avoid. NE keeps the fragment
  # from being escaped.
  RewriteRule ^about/?$   /#muons   [R=301,NE,L]
  RewriteRule ^company/?$ /#muons   [R=301,NE,L]
  RewriteRule ^team/?$    /#team    [R=301,NE,L]
  RewriteRule ^contact/?$ /#contact [R=301,NE,L]

  # Every route this app serves is pre-rendered to a real file, so there is no
  # need to rewrite unknown paths to index.html. Doing so returned 200 for URLs
  # that do not exist - a soft 404 - which wastes crawl budget and lets
  # nonexistent routes be indexed. Unknown paths now fall through to Apache and
  # are answered by ErrorDocument below, with a genuine 404 status.
</IfModule>

# The app shell, so the router still renders the NotFound page at the URL the
# visitor requested, while the status code stays correct.
ErrorDocument 404 /404.html

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build assets are immutable; the HTML entry points must not be.
  <FilesMatch "\.(js|css|woff2?|svg|jpg|jpeg|png|webp|avif|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # max-age=0 keeps browsers revalidating, so a deploy is picked up on the next
  # visit. s-maxage lets the CDN answer from its edge for a few minutes instead
  # of forwarding every request to the origin: without it the cache status was
  # DYNAMIC on every hit and each visitor paid the full origin round trip.
  # The cost is that a deploy can take up to s-maxage to appear everywhere.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Correct types ----------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# --- Endpoint hardening -----------------------------------------------------
# The vendored PHPMailer sources are included by contact.php and must never be
# requested directly.
# Belt and braces if a config file is ever placed inside the web root by
# mistake; it belongs one level above it.
<FilesMatch "^muons-contact-config\.php$">
  Require all denied
</FilesMatch>
